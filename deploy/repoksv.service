[Unit]
Description=RepoKSV FastAPI Backend (Track A - Free2Play)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repoksv
Group=repoksv
WorkingDirectory=/opt/repoksv
EnvironmentFile=/opt/repoksv/.env
ExecStart=/opt/repoksv/.venv/bin/uvicorn codebase.server:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/repoksv/.study_logs

[Install]
WantedBy=multi-user.target
