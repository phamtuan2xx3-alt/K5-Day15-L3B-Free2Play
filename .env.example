# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Trên VPS đặt quyền chmod 600 .env.
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả · gemini / openai / anthropic / ollama / vilao
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
API_BASE_URL=

# GitHub Fine-Grained PAT chỉ đọc public repo (tùy chọn, nâng quota từ 60 lên 5.000 req/giờ)
GITHUB_TOKEN=

# Google OAuth 2.0 (PKCE) + Cookie HMAC-SHA256 cho Web RepoKSV
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Chế độ Guest Demo không cần đăng nhập (giới hạn 30 lượt LLM/ngày khi bật true)
ALLOW_GUEST_DEMO=false

# Tùy chọn Docker / Deploy AWS VPS (Caddy reverse proxy)
REPOKSV_DOMAIN=repoksv.tuanpq.com
UVICORN_WORKERS=2
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32,::1/128
